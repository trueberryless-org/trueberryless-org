---
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";

type Props = {
  title: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
};

const { title, description, keywords, image, canonical } = Astro.props;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
>
  <MainNavigation {...mainNavData} />

  <main>
    <slot />
  </main>
  <Footer {...footerData} />
</Layout>
